{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/s/:id",
      "destination": "/api/p?s=:id"
    },
    {
      "source": "/:h(@[^/]+)",
      "destination": "/api/p?p=:h"
    },
    {
      "source": "/termos",
      "destination": "/legal.html"
    },
    {
      "source": "/privacidade",
      "destination": "/legal.html"
    },
    {
      "source": "/destaques",
      "destination": "/index.html"
    },
    {
      "source": "/meus-sites",
      "destination": "/index.html"
    },
    {
      "source": "/publicar",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/p.js": {
      "includeFiles": "index.html"
    }
  }
}
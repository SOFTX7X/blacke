{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/bio/:h",
      "destination": "/api/bio?h=:h"
    },
    {
      "source": "/selo/:h",
      "destination": "/api/selo?h=:h"
    },
    {
      "source": "/s/:id",
      "destination": "/api/p?s=:id"
    },
    {
      "source": "/:h(@[^/]+)",
      "destination": "/api/p?p=:h"
    },
    {
      "source": "/termos",
      "destination": "/legal.html"
    },
    {
      "source": "/privacidade",
      "destination": "/legal.html"
    },
    {
      "source": "/destaques",
      "destination": "/index.html"
    },
    {
      "source": "/usuarios",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/meus-sites",
      "destination": "/index.html"
    },
    {
      "source": "/publicar",
      "destination": "/index.html"
    },
    {
      "source": "/conta",
      "destination": "/index.html"
    },
    {
      "source": "/configuracoes",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/p.js": {
      "includeFiles": "index.html"
    },
    "api/og.py": {
      "includeFiles": "api/_og/**",
      "maxDuration": 15
    }
  }
}
